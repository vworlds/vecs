{
  "name": "@vworlds/vecs-phaser-client",
  "version": "1.0.50",
  "private": false,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./headless": {
      "types": "./dist/headless.d.ts",
      "import": "./dist/headless.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "check:headless": "node --import ../../bench/register-dist.mjs scripts/check-headless.mjs",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" --no-error-on-unmatched-pattern",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@vworlds/vecs-client": "1.0.50",
    "@vworlds/vecs-phaser": "1.0.50"
  },
  "peerDependencies": {
    "phaser": "^4.1.0"
  },
  "devDependencies": {
    "phaser": "^4.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/vworlds/vecs",
    "directory": "lib/vecs-phaser-client"
  }
}
