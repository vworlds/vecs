{
  "name": "@vworlds/vecs-phaser-server",
  "version": "1.0.57",
  "private": false,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" --no-error-on-unmatched-pattern",
    "test": "vitest run --passWithNoTests",
    "test:stress": "vitest run --config vitest.stress.config.ts --passWithNoTests"
  },
  "dependencies": {
    "@vworlds/vecs-phaser": "1.0.57",
    "@vworlds/vecs-physics": "1.0.57",
    "@vworlds/vecs-protocol": "1.0.57",
    "@vworlds/vecs-server": "1.0.57"
  },
  "peerDependencies": {
    "express": "^5.2.1"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "express": "^5.2.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/vworlds/vecs",
    "directory": "lib/vecs-phaser-server"
  }
}
