{
  "name": "@vworlds/vecs-mcp",
  "version": "1.0.58",
  "private": false,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "vecs-mcp": "dist/bin/hub.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "import": "./dist/schema/index.js"
    }
  },
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" --no-error-on-unmatched-pattern",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@vworlds/vecs": "1.0.58",
    "@vworlds/vecs-protocol": "1.0.58",
    "@vworlds/vecs-wire": "1.0.58",
    "ws": "8.22.0",
    "zod": "^3.25.76"
  },
  "peerDependencies": {
    "@vworlds/vecs-client": "^1.0.58",
    "@vworlds/vecs-server": "^1.0.58"
  },
  "peerDependenciesMeta": {
    "@vworlds/vecs-client": {
      "optional": true
    },
    "@vworlds/vecs-server": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/ws": "8.18.1",
    "esbuild": "^0.28.1"
  },
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/vworlds/vecs",
    "directory": "lib/vecs-mcp"
  }
}
