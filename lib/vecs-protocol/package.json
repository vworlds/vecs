{
  "name": "@vworlds/vecs-protocol",
  "version": "1.0.34",
  "private": false,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rimraf dist",
    "prepack": "npm run build",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" --no-error-on-unmatched-pattern",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@vworlds/vecs": "1.0.34",
    "@vworlds/vecs-wire": "1.0.34"
  },
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/vworlds/vecs",
    "directory": "lib/vecs-protocol"
  }
}
